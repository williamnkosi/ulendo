{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    "drivers": {
      "$driverId": {
        // Allow drivers to read/write their own data
        ".read": "auth != null && auth.uid === $driverId",
        ".write": "auth != null && auth.uid === $driverId",
        "location": {
          // Allow drivers to continuously update their location
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.hasChildren(['driverId', 'latitude', 'longitude'])"
        }
      }
    }
  }
}
